---
import Shell from './Shell.astro';
import Showcase from '../components/Showcase.astro';
import Features from '../components/Features.astro';
import Installer from '../components/Installer.astro';
import ResearchExtension from '../components/ResearchExtension.astro';
import type { SiteCopy } from '../content/types';
import { release } from '../content/release';
interface Props { copy: SiteCopy }
const { copy } = Astro.props;
const home = `${import.meta.env.BASE_URL}${copy.lang === 'en' ? 'en/' : ''}`;
const resourceUrl = (path: string) => path === 'docs/QUICKSTART.md' ? `${home}docs/` : path === 'docs/custom/README.md' ? `${home}docs/task/` : `${release.repository}/blob/main/${path}`;
---
<Shell copy={copy}>
      <Showcase copy={copy} />
      <Features copy={copy} />
      <ResearchExtension lang={copy.lang} />
      <Installer copy={copy} />
      <section id="resources" class="section" aria-labelledby="resources-title">
        <div class="container">
          <p class="section-label"><b>§ 7</b>{copy.resources.eyebrow}</p>
          <div class="section-body">
            <h2 id="resources-title">{copy.resources.title}</h2>
            <p class="section-intro">{copy.resources.intro}</p>
            <ul class="link-list">{copy.resources.items.map(item => <li><a href={resourceUrl(item.path)}><h3>{item.title}</h3><p>{item.description}</p><span aria-hidden="true">{resourceUrl(item.path).startsWith('http') ? '↗' : '→'}</span></a></li>)}</ul>
            <div class="citation"><p>{copy.resources.citation.replace('{version}', release.version).replace('{doi}', release.doi)}</p><a class="button" href={`${release.repository}/blob/main/CITATION.cff`}>{copy.resources.citeLabel} ↗</a></div>
          </div>
        </div>
      </section>

</Shell>
