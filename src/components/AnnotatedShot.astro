---
import type { Language } from '../content/types';
import { figures, type AnnotatedFigure, type FigureId } from '../content/figures';
import '../styles/annotated.css';

/**
 * A real capture with numbered targets. The steps are listed to the left of the capture and the selected one opens
 * there, so the image is never covered and reading never means scrolling away from it. Without JavaScript every
 * step is open.
 */
interface Props { figure: FigureId; lang: Language }
const { figure: id, lang } = Astro.props;
const figure: AnnotatedFigure = figures[id];
const base = import.meta.env.BASE_URL;
const pt = lang === 'pt';
const stem = figure.localized ? `${figure.image}${figure.localized === 'suffix' ? (pt ? '' : '-en') : `-${lang}`}` : figure.image;
const sources = figure.themed
  ? [{ src: `${base}images/${stem}-dark.webp`, cls: 'shot-dark' }, { src: `${base}images/${stem}-light.webp`, cls: 'shot-light' }]
  : [{ src: `${base}images/${stem}.webp`, cls: undefined }];
const caption = figure.caption[lang];
---
<div class="shot" data-shot style={`--shot-width:${figure.displayWidth}px`}>
  <figure class="figure shot-figure">
    <div class="shot-grid">
      <ol class="shot-steps" aria-label={pt ? 'Passo a passo da captura' : 'Walk-through of the capture'}>
        {figure.targets.map((target, i) => (
          <li class="shot-step" data-shot-step>
            <button type="button" class="shot-step-head" data-shot-head aria-expanded="true" aria-controls={`${id}-target-${i + 1}`}>
              <span class="shot-num" aria-hidden="true">{i + 1}</span><b>{target.title[lang]}</b>
            </button>
            <div class="shot-step-body" id={`${id}-target-${i + 1}`}><p>{target.text[lang]}</p></div>
          </li>
        ))}
      </ol>
      <div class="shot-stage">
        <div class="figure-frame shot-frame">
          {sources.map(source => <img class={source.cls} src={source.src} alt={caption} width={figure.width} height={figure.height} loading="lazy" decoding="async" />)}
        </div>
        <div class="shot-markers" role="group" aria-label={pt ? 'Alvos na captura' : 'Targets on the capture'}>
          <i class="shot-halo" data-shot-halo aria-hidden="true"></i>
          {figure.targets.map((target, i) => (
            <button type="button" class="shot-marker" data-shot-marker aria-pressed="false" aria-label={`${i + 1}: ${target.title[lang]}`} aria-describedby={`${id}-target-${i + 1}`} style={`left:${target.x}%;top:${target.y}%`}>{i + 1}</button>
          ))}
        </div>
      </div>
    </div>
    <figcaption>{caption}</figcaption>
  </figure>
</div>
<script>
  /** Opens one step at a time, lights its target on the capture and walks through them until the visitor takes over. */
  document.querySelectorAll<HTMLElement>('[data-shot]').forEach((root) => {
    const markers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-shot-marker]'));
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-shot-step]'));
    const heads = steps.map(step => step.querySelector<HTMLButtonElement>('[data-shot-head]')!);
    const halo = root.querySelector<HTMLElement>('[data-shot-halo]');
    if (!halo || !markers.length || markers.length !== steps.length) return;
    let current = 0; let timer: number | undefined;
    const select = (index: number) => {
      current = (index + markers.length) % markers.length;
      markers.forEach((marker, i) => marker.setAttribute('aria-pressed', String(i === current)));
      steps.forEach((step, i) => { step.classList.toggle('is-open', i === current); heads[i].setAttribute('aria-expanded', String(i === current)); });
      // One halo slides from target to target instead of a new one appearing at each.
      halo.style.left = markers[current].style.left; halo.style.top = markers[current].style.top;
    };
    const stop = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } };
    markers.forEach((marker, i) => marker.addEventListener('click', () => { stop(); select(i); }));
    heads.forEach((head, i) => head.addEventListener('click', () => { stop(); select(i); }));
    root.dataset.enhanced = 'true';
    select(0);
    // The walk-through is motion: it only runs when motion is welcome and the figure is on screen.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    let interacted = false;
    root.addEventListener('pointerdown', () => { interacted = true; }, { once: true });
    root.addEventListener('focusin', () => { interacted = true; stop(); }, { once: true });
    new IntersectionObserver(([entry]) => {
      stop();
      if (entry.isIntersecting && !interacted) timer = window.setInterval(() => select(current + 1), 5000);
    }, { threshold: 0.4 }).observe(root);
  });
</script>
