---
import type { SiteCopy } from '../content/types';
import AnnotatedShot from './AnnotatedShot.astro';
/** Props for the landing section that explains the interface through the annotated Data-step capture. */
interface Props { copy: SiteCopy }
const { copy } = Astro.props;
---
<section id="tour" class="tour" aria-labelledby="tour-title">
  <div class="container">
    <p class="eyebrow">{copy.tour.eyebrow}</p>
    <h2 id="tour-title">{copy.tour.title}</h2>
    <p class="section-intro">{copy.tour.intro}</p>
    <AnnotatedShot figure="data-step" lang={copy.lang} label={`${copy.labels.figure} 1`} eager />
  </div>
</section>
