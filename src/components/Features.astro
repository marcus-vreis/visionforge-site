---
import type { SiteCopy } from '../content/types';
import { release, plannedVersion } from '../content/release';
import '../styles/showcase.css';
/** Props for the availability section: released features and those only on the development branch. */
interface Props { copy: SiteCopy }
const { copy } = Astro.props;
const pt = copy.lang === 'pt';
const home = `${import.meta.env.BASE_URL}${pt ? '' : 'en/'}`;
/** Fill the {version} and {planned} placeholders shared by both languages. */
const fill = (text: string) => text.replaceAll('{version}', release.version).replaceAll('{planned}', plannedVersion);
---
<section id="features" class="section features-section" aria-labelledby="features-title">
  <div class="container">
    <span class="eyebrow">{copy.features.eyebrow}</span>
    <h2 id="features-title">{copy.features.title}</h2>
    <p class="section-intro">{fill(copy.features.intro)}</p>
    {copy.features.groups.map(group => (
      <div class="feature-group" data-group={group.id}>
        <h3 class="feature-group-title">{fill(group.heading)}</h3>
        <ul class="feature-cards">
          {group.items.map(item => (
            <li class="feature-card">
              <span class={`feature-mark ${group.id}`}>{fill(item.mark)}</span>
              <h4>{item.title}</h4>
              <p>{item.description}</p>
              {item.guide && <a href={`${home}${item.guide}`}>{pt ? 'Ler o guia' : 'Read the guide'} →</a>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
