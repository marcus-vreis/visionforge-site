---
/** Props for the animated replicas illustration; the labels are translated, the marks carry no data. */
interface Props { seed: string; summary: string; caption: string; label: string }
const { seed, summary, caption, label } = Astro.props;
const rows = [0, 1, 2, 3, 4];
// Illustrative positions only: where each run's dot lands on an unlabelled metric axis.
const dots = [452, 506, 474, 528, 490];
const mean = dots.reduce((a, b) => a + b, 0) / dots.length;
// One loop: each seed fills its bar and drops its dot in turn, then the summary appears and holds.
const css = rows.map((i) => {
  const start = 4 + i * 11; const end = start + 10;
  return `@keyframes rep-bar-${i}{0%,${start}%{transform:scaleX(0)}${end}%,96%{transform:scaleX(1)}100%{transform:scaleX(0)}}@keyframes rep-dot-${i}{0%,${end - 1}%{opacity:0}${end + 2}%,96%{opacity:1}100%{opacity:0}}.rep-bar-${i}{animation:rep-bar-${i} 11s linear infinite}.rep-dot-${i}{animation:rep-dot-${i} 11s linear infinite}`;
}).join('') + '@keyframes rep-sum{0%,62%{opacity:0}68%,96%{opacity:1}100%{opacity:0}}.rep-sum{animation:rep-sum 11s linear infinite}';
---
<figure class="figure replicas">
  <div class="figure-frame">
    <svg viewBox="0 0 640 210" role="img" aria-label={caption} focusable="false">
      {rows.map((i) => (
        <g>
          <text class="rep-text" x="20" y={38 + i * 34}>{seed} {i + 1}</text>
          <rect class="rep-track" x="92" y={28 + i * 34} width="230" height="12" rx="2" />
          <rect class={`rep-fill rep-bar-${i}`} x="92" y={28 + i * 34} width="230" height="12" rx="2" style="transform-box:fill-box;transform-origin:left center" />
        </g>
      ))}
      <path class="rep-axis" d="M400 150H600" />
      {dots.map((x, i) => <circle class={`rep-dot rep-dot-${i}`} cx={x} cy="132" r="6" />)}
      <g class="rep-sum">
        <path class="rep-ci" d={`M${mean - 42} 96H${mean + 42}M${mean - 42} 88V104M${mean + 42} 88V104`} />
        <path class="rep-mean" d={`M${mean} 84V150`} />
        <text class="rep-text rep-summary" x={mean} y="68" text-anchor="middle">{summary}</text>
      </g>
    </svg>
  </div>
  <figcaption><b>{label}</b>{caption}</figcaption>
</figure>
<style is:global set:html={css}></style>
