---
import type { SiteCopy } from '../content/types';
import { release } from '../content/release';
import Tour from './Tour.astro';
import Replicas from './Replicas.astro';
import { plannedVersion } from '../content/release';
import '../styles/showcase.css';

/** Props for the opening statement plus the tasks, workflow and method sections. */
interface Props { copy: SiteCopy }

const { copy } = Astro.props;
const base = import.meta.env.BASE_URL;
// Terminal session from the product's docs/INSTALL.md: its commands, the endings it documents for doctor and
// selftest, and the address the interface opens at. `at` is when each line appears, in seconds.
const session = [
  { text: 'pip install visionforge-studio', at: 0.4 },
  { text: 'visionforge doctor', at: 2.4 },
  { text: 'environment looks good', at: 3.7, out: true },
  { text: 'visionforge selftest --quick', at: 4.5 },
  { text: '5/5 cases passed', at: 6.4, out: true },
  { text: 'visionforge gui', at: 7.2 },
  { text: 'http://127.0.0.1:8000', at: 8.4, out: true },
];
// Copy titles may carry "1." prefixes; the list numbers itself.
const stripNumber = (title: string) => title.replace(/^\s*\d+[.)]\s*/, '');
const { figure, table } = copy.labels;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-meta">
        <a href={release.url}>v{release.version}</a>
        <span>MIT</span>
        <span>Python 3.12 / 3.13</span>
        <span>{copy.hero.platforms}</span>
      </p>
      <h1 id="hero-title" class="hero-title">{copy.hero.title}</h1>
      <p class="hero-lede">{copy.hero.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#install">{copy.hero.install}<span aria-hidden="true">↓</span></a>
        <a class="button" href={release.repository}>{copy.hero.github}<span aria-hidden="true">↗</span></a>
      </div>
      <a class="hero-live" href="#features"><span class="pulse" aria-hidden="true"></span>{copy.hero.development.replace('{planned}', plannedVersion)}<span aria-hidden="true"> →</span></a>
    </div>
    <figure class="hero-session" data-session>
      <div class="terminal hero-terminal">
        <div class="terminal-bar"><span>{copy.hero.terminalLabel}</span><button hidden class="copy-button" type="button" data-replay>{copy.hero.replay}</button></div>
        <pre tabindex="0" role="group" aria-label={copy.hero.terminalLabel}><code>{session.map((line) => (
          <span class={`t-line ${line.out ? 't-out' : 't-cmd'}`} style={`--d:${line.at}s;--n:${line.text.length}`}><span>{line.text}</span></span>
        ))}</code></pre>
      </div>
      <figcaption>{copy.hero.terminalCaption}</figcaption>
    </figure>
  </div>
</section>

<Tour copy={copy} />

<section id="tasks" class="section" aria-labelledby="tasks-title">
  <div class="container">
    <p class="section-label"><b>§ 1</b>{copy.tasks.eyebrow}</p>
    <div class="section-body">
      <h2 id="tasks-title">{copy.tasks.title}</h2>
      <p class="section-intro">{copy.tasks.intro}</p>
      <table class="data-table stack task-table">
        <caption class="table-caption"><b>{table} 1</b>{copy.tasks.caption}</caption>
        <thead>
          <tr><th scope="col">{copy.tasks.task}</th><th scope="col">{copy.tasks.models}</th><th scope="col">{copy.tasks.metrics}</th></tr>
        </thead>
        <tbody>
          {copy.tasks.items.map((task) => (
            <tr id={`task-${task.id}`}>
              <th scope="row">{task.name}<span class="cell-note">{task.description}</span></th>
              <td data-label={copy.tasks.models}>{task.models}</td>
              <td data-label={copy.tasks.metrics}>{task.metrics}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section id="workflow" class="section" aria-labelledby="workflow-title">
  <div class="container">
    <p class="section-label"><b>§ 2</b>{copy.workflow.eyebrow}</p>
    <div class="section-body">
      <h2 id="workflow-title">{copy.workflow.title}</h2>
      <ol class="steps">
        {copy.workflow.steps.map((step) => (
          <li class="step">
            <h3>{stripNumber(step.title)}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section id="research" class="section" aria-labelledby="research-title">
  <div class="container">
    <p class="section-label"><b>§ 3</b>{copy.research.eyebrow}</p>
    <div class="section-body">
      <h2 id="research-title">{copy.research.title}</h2>
      <p class="section-intro">{copy.research.intro}</p>
      <dl class="method-list">
        {copy.research.items.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.description}</dd>
          </div>
        ))}
      </dl>
      <p class="method-note">{copy.research.note}</p>
      <Replicas seed={copy.research.replicas.seed} summary={copy.research.replicas.summary} caption={copy.research.replicas.caption} label={`${figure} 2`} />
      <figure class="figure">
        <div class="figure-frame">
          <img src={`${base}images/replicates-pt-dark.webp`} alt={copy.research.figure} width="1440" height="960" loading="lazy" decoding="async" />
        </div>
        <figcaption><b>{figure} 3</b>{copy.research.figure}</figcaption>
      </figure>
      <h3 class="subhead">{copy.research.runJson.title}</h3>
      <table class="data-table stack runjson-table">
        <caption class="table-caption"><b>{table} 2</b>{copy.research.runJson.caption}</caption>
        <thead>
          <tr><th scope="col">{copy.research.runJson.field}</th><th scope="col">{copy.research.runJson.records}</th></tr>
        </thead>
        <tbody>
          {copy.research.runJson.fields.map((field) => (
            <tr>
              <th scope="row"><code>{field.key}</code></th>
              <td>{field.records}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  /** Replays the terminal session by restarting its CSS animations. */
  document.querySelectorAll<HTMLElement>('[data-session]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-replay]');
    if (!button || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      root.dataset.session = 'reset';
      void root.offsetWidth;
      root.dataset.session = '';
    });
  });
</script>
