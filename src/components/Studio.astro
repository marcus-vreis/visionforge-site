---
import type { SiteCopy } from '../content/types';
import { release } from '../content/release';
import { studioText, studioTour } from '../content/studio';
import { initialState, renderStudio } from '../scripts/studio-render';
import '../styles/studio.css';

/** Props for the full-width, simplified replica of the application and the tour that plays over it. */
interface Props { copy: SiteCopy }
const { copy } = Astro.props;
const lang = copy.lang;
const t = (key: keyof typeof studioText) => studioText[key][lang];
---
<section id="tour" class="tour" aria-labelledby="tour-title">
  <div class="container">
    <p class="eyebrow">{copy.tour.eyebrow}</p>
    <h2 id="tour-title">{copy.tour.title}</h2>
    <p class="section-intro">{copy.tour.intro}</p>
  </div>
  <div class="studio" data-studio data-lang={lang} data-version={release.version} data-task="classification">
    <div class="studio-stage" data-studio-stage>
      <div class="studio-window" data-studio-window set:html={renderStudio(initialState(), lang, release.version)} />
      <!-- The tour: a ring whose shadow shades everything but its target, and a card that glides between stops. -->
      <div hidden class="studio-tour" data-tour>
        <i class="tour-ring" data-tour-ring></i>
        <div class="tour-card" data-tour-card role="group" aria-label={t('tourLabel')}>
          <p class="tour-eyebrow"><span data-tour-count></span><span class="tour-dots" aria-hidden="true">{studioTour.map(() => <i></i>)}</span></p>
          <div class="tour-copy" data-tour-copy>
            <p class="tour-title" data-tour-title></p>
            <p class="tour-text" data-tour-text></p>
          </div>
          <div class="tour-actions">
            <button type="button" class="tour-ghost" data-tour-skip>{t('tourSkip')}</button>
            <button type="button" class="tour-btn" data-tour-prev>{t('tourPrev')}</button>
            <button type="button" class="tour-btn tour-primary" data-tour-next data-next={t('tourNext')} data-finish={t('tourFinish')}><span data-tour-next-label>{t('tourNext')}</span><i class="tour-timer" data-tour-timer aria-hidden="true"></i></button>
          </div>
        </div>
      </div>
    </div>
    <p class="studio-note">{t('demo').replace('{version}', release.version)}</p>
    <!-- Without JavaScript the replica cannot react, so the tour's explanations are listed instead. -->
    <noscript>
      <ol class="studio-fallback">{studioTour.map(stop => <li><b>{stop.title[lang]}.</b> {stop.text[lang]}</li>)}</ol>
    </noscript>
  </div>
</section>
<script>
  import type { Language } from '../content/types';
  import { studioTour } from '../content/studio';
  import { canTrain, initialState, renderStudio, type StudioState } from '../scripts/studio-render';

  const STOP_MS = 7000;
  const MARGIN = 16;
  const GAP = 14;
  const PAD = 6;

  /** Makes the replica react to clicks and plays the tour over it once it scrolls into view. */
  document.querySelectorAll<HTMLElement>('[data-studio]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-studio-stage]')!;
    const view = root.querySelector<HTMLElement>('[data-studio-window]')!;
    const tour = root.querySelector<HTMLElement>('[data-tour]')!;
    const q = <T extends HTMLElement>(name: string) => tour.querySelector<T>(`[data-tour-${name}]`)!;
    const ring = q('ring'); const card = q('card'); const copy = q('copy'); const timerBar = q('timer');
    const prev = q<HTMLButtonElement>('prev'); const next = q<HTMLButtonElement>('next');
    const dots = Array.from(tour.querySelectorAll<HTMLElement>('.tour-dots i'));
    const lang = root.dataset.lang as Language;
    const version = root.dataset.version ?? '';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let state: StudioState = initialState();
    let shown = { task: state.task, step: state.step };
    let stop = -1; let timer: number | undefined; let onScreen = false; let held = false; let autoplay = !reduced; let offered = false;

    const paint = (focus?: string) => {
      // Only a change of task or step replays the entrance of the panel; a choice inside a step does not.
      const enter = state.task !== shown.task ? 'task' : state.step !== shown.step ? 'step' : '';
      shown = { task: state.task, step: state.step };
      root.dataset.task = state.task;
      view.innerHTML = renderStudio(state, lang, version);
      if (enter) view.dataset.enter = enter; else delete view.dataset.enter;
      if (focus) view.querySelector<HTMLElement>(focus)?.focus({ preventScroll: true });
    };

    /** Where an element sits inside the replica by layout alone, so an entrance animation in progress does not move the cut-out. */
    const layoutBox = (el: HTMLElement) => {
      let left = view.clientLeft; let top = view.clientTop;
      for (let node: HTMLElement | null = el; node && node !== view; node = node.offsetParent as HTMLElement | null) { left += node.offsetLeft; top += node.offsetTop; }
      for (let node = el.parentElement; node && node !== view; node = node.parentElement) { left -= node.scrollLeft; top -= node.scrollTop; }
      return { left, top, right: left + el.offsetWidth, bottom: top + el.offsetHeight };
    };

    /** Puts the cut-out on the stop's target and the card where it fits: below, above, beside, or over the centre. */
    const place = (animate: boolean) => {
      if (stop < 0) return;
      tour.classList.toggle('is-still', !animate);
      const target = view.querySelector<HTMLElement>(`[data-spot="${studioTour[stop].target}"]`);
      const width = stage.clientWidth; const height = stage.clientHeight;
      const raw = target ? layoutBox(target) : null;
      const r = raw
        ? { left: Math.max(0, raw.left - PAD), top: Math.max(0, raw.top - PAD), right: Math.min(width, raw.right + PAD), bottom: Math.min(height, raw.bottom + PAD) }
        : { left: width / 2, top: height / 2, right: width / 2, bottom: height / 2 };
      const set = (el: HTMLElement, left: number, top: number, w: number, h: number) => {
        el.style.left = `${left}px`; el.style.top = `${top}px`; el.style.width = `${Math.max(0, w)}px`; el.style.height = `${Math.max(0, h)}px`;
      };
      set(ring, r.left, r.top, r.right - r.left, r.bottom - r.top);

      const cw = card.offsetWidth; const ch = card.offsetHeight;
      const clampX = (x: number) => Math.min(Math.max(MARGIN, x), Math.max(MARGIN, width - cw - MARGIN));
      const clampY = (y: number) => Math.min(Math.max(MARGIN, y), Math.max(MARGIN, height - ch - MARGIN));
      const centreX = clampX((r.left + r.right) / 2 - cw / 2); const centreY = clampY((r.top + r.bottom) / 2 - ch / 2);
      let left = centreX; let top = clampY((height - ch) / 2);
      if (r.bottom + GAP + ch + MARGIN <= height) top = r.bottom + GAP;
      else if (r.top - GAP - ch >= MARGIN) top = r.top - GAP - ch;
      else if (r.right + GAP + cw + MARGIN <= width) { left = r.right + GAP; top = centreY; }
      else if (r.left - GAP - cw >= MARGIN) { left = r.left - GAP - cw; top = centreY; }
      card.style.left = `${left}px`; card.style.top = `${top}px`;
    };

    const schedule = () => {
      window.clearTimeout(timer);
      timerBar.classList.remove('is-running');
      if (stop < 0 || !autoplay || held || !onScreen || document.hidden || stop === studioTour.length - 1) return;
      void timerBar.offsetWidth;
      timerBar.classList.add('is-running');
      timer = window.setTimeout(() => show(stop + 1), STOP_MS);
    };

    const show = (index: number) => {
      const first = stop < 0;
      stop = Math.min(Math.max(0, index), studioTour.length - 1);
      const item = studioTour[stop];
      state.task = item.task; state.step = item.step; state.trained = false;
      if (item.strategy) state.strategy[item.task] = item.strategy;
      paint();
      q('count').textContent = `${String(stop + 1).padStart(2, '0')} / ${String(studioTour.length).padStart(2, '0')}`;
      q('title').textContent = item.title[lang];
      q('text').textContent = item.text[lang];
      dots.forEach((dot, i) => { dot.classList.toggle('is-done', i < stop); dot.classList.toggle('is-current', i === stop); });
      prev.hidden = stop === 0;
      q('next-label').textContent = (stop === studioTour.length - 1 ? next.dataset.finish : next.dataset.next) ?? '';
      // The words fade in again at every stop while the card glides to its new place.
      copy.classList.remove('is-in'); void copy.offsetWidth; copy.classList.add('is-in');
      place(!first);
      schedule();
    };

    const open = (auto: boolean) => {
      if (stop >= 0) return;
      offered = true; autoplay = auto && !reduced;
      state = initialState();
      tour.hidden = false;
      show(0);
      // One frame with the tour laid out but transparent, so the shade and the card fade in.
      requestAnimationFrame(() => { root.dataset.touring = 'true'; });
    };
    const close = (focusGuide = false) => {
      if (stop < 0) return;
      window.clearTimeout(timer); stop = -1;
      delete root.dataset.touring;
      window.setTimeout(() => { if (stop < 0) tour.hidden = true; }, reduced ? 0 : 420);
      if (focusGuide) view.querySelector<HTMLElement>('[data-act="tour"]')?.focus({ preventScroll: true });
    };

    next.addEventListener('click', () => { autoplay = false; if (stop === studioTour.length - 1) close(true); else show(stop + 1); });
    prev.addEventListener('click', () => { autoplay = false; show(stop - 1); });
    q('skip').addEventListener('click', () => close(true));
    // Reading or reaching for the card holds the stop; leaving it lets the tour go on.
    const hold = (value: boolean) => { held = value; schedule(); };
    card.addEventListener('pointerenter', () => hold(true));
    card.addEventListener('pointerleave', () => hold(false));
    card.addEventListener('focusin', () => hold(true));
    card.addEventListener('focusout', () => hold(false));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close(true);
      else if (event.key === 'ArrowRight' && stop < studioTour.length - 1) { autoplay = false; show(stop + 1); }
      else if (event.key === 'ArrowLeft' && stop > 0) { autoplay = false; show(stop - 1); }
    });

    view.addEventListener('click', (event) => {
      const control = (event.target as HTMLElement).closest<HTMLElement>('[data-act]');
      if (!control) return;
      const { act, value = '' } = control.dataset;
      if (act === 'tour') { if (stop < 0) open(false); else close(); return; }
      // A click inside the replica means the visitor took over: the tour steps aside.
      close();
      let focus = `[data-act="${act}"][data-value="${value}"]`;
      if (act === 'task') { state.task = value as StudioState['task']; state.trained = false; }
      else if (act === 'step') { state.step = value as StudioState['step']; state.trained = false; focus = `.vf-rail [data-value="${value}"]`; }
      else if (act === 'strategy') state.strategy[state.task] = value as StudioState['strategy'][string];
      else if (act === 'model') state.model[state.task] = value;
      else if (act === 'sample') { state.dataset[state.task] = true; focus = '[data-act="sample"]'; }
      else if (act === 'train') { if (!canTrain(state)) return; state.trained = true; focus = '[data-act="train"]'; }
      paint(focus);
    });

    // Arrow keys move between task tabs, as in the application.
    view.addEventListener('keydown', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLElement>('[role="tab"]');
      if (!tab || !['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
      const tabs = Array.from(view.querySelectorAll<HTMLElement>('[role="tab"]'));
      const at = tabs.indexOf(tab);
      const to = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (at + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      event.preventDefault();
      tabs[to].click();
    });

    // The cut-out stays glued to its target when the stage changes size.
    if ('ResizeObserver' in window) new ResizeObserver(() => place(false)).observe(stage);
    document.addEventListener('visibilitychange', schedule);

    root.dataset.enhanced = 'true';
    if (!('IntersectionObserver' in window)) { stage.classList.add('is-seen'); return; }
    // The tour is offered once, when the whole replica is on screen (its bottom bar is part of the tour),
    // and waits whenever a good part of it is not.
    new IntersectionObserver(([entry]) => {
      onScreen = entry.intersectionRatio >= 0.75;
      if (entry.isIntersecting) stage.classList.add('is-seen');
      if (entry.intersectionRatio >= 0.9 && !offered && !reduced) open(true); else schedule();
    }, { threshold: [0, 0.15, 0.75, 0.9] }).observe(stage);
  });
</script>
